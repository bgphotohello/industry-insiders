# ---------------------------------------------------------------------------
# Industry Insider — environment configuration
#
# Copy this file to `.env.local` for local development:
#   cp .env.example .env.local
#
# In production (Vercel), set these under:
#   Project → Settings → Environment Variables
#
# Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# Every other value below is read exclusively on the server.
# ---------------------------------------------------------------------------

# Canonical site origin. Used for canonical URLs, Open Graph, robots + sitemap.
# No trailing slash. Example: https://industryinsider.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Lead capture destination
#
# Which provider receives interest-list submissions.
# One of: console | file | webhook | resend | supabase
#
#   console  — logs a redacted summary to the server console (default in dev)
#   file     — appends JSON lines to ./.leads/leads.jsonl (development only,
#              git-ignored; refuses to run in production)
#   webhook  — POSTs JSON to LEAD_WEBHOOK_URL (GoHighLevel, Zapier, any CRM)
#   resend   — emails a formatted notification via the Resend API
#   supabase — inserts a row into the `leads` table via the service role key
#
# Multiple providers can be chained with commas, e.g. "supabase,resend".
# ---------------------------------------------------------------------------
LEAD_CAPTURE_PROVIDER=console

# webhook provider ------------------------------------------------------------
LEAD_WEBHOOK_URL=
# Optional shared secret sent as the `x-industry-insider-signature` header.
LEAD_WEBHOOK_SECRET=

# resend provider -------------------------------------------------------------
RESEND_API_KEY=
# Verified sender. Once industryinsiderstx.com is verified in Resend, use:
#   Industry Insider <notifications@industryinsiderstx.com>
RESEND_FROM_EMAIL=
# Internal recipient(s) for new-lead notifications, comma separated.
RESEND_TO_EMAIL=info@industryinsiderstx.com

# supabase provider -----------------------------------------------------------
# NEXT_PUBLIC_* values are safe for the browser and will be needed later for
# member authentication. The service role key must NEVER be prefixed with
# NEXT_PUBLIC_ and must never be imported into a client component.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Table that receives interest-list rows.
SUPABASE_LEADS_TABLE=leads

# Reserved for the future member portal (/login, /member, /admin).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Cloudflare Turnstile (optional bot protection)
#
# Leave both blank to disable. Turnstile activates only when BOTH values are
# present; the form falls back to honeypot + rate limiting otherwise.
#
# TURNSTILE_SITE_KEY is a public value but is read on the server and passed to
# the widget as a prop, so it needs no NEXT_PUBLIC_ prefix.
# ---------------------------------------------------------------------------
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
